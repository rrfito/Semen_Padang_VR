# =====================================================
# VIRTUAL TOUR SEMEN PADANG - ENVIRONMENT CONFIGURATION
# =====================================================
# Salin file ini menjadi .env dan sesuaikan nilai-nilai di bawah ini.
# File ini TIDAK BOLEH di-commit ke version control!
# =====================================================

# === KONFIGURASI APLIKASI ===
APP_NAME="Virtual Tour Semen Padang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# === LOGGING ===
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# === DATABASE (PostgreSQL + PostGIS) ===
# PENTING: Sesuaikan dengan konfigurasi database lokal Anda!
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=semen_padang_vr
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# === SESSION ===
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === QUEUE (WAJIB untuk background processing) ===
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# === CACHE ===
CACHE_STORE=database
CACHE_PREFIX=

# === REDIS (Opsional, tidak digunakan secara default) ===
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# === MAIL (Opsional, log by default) ===
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@semenpadang.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# === AWS (Tidak digunakan) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# === VITE ===
VITE_APP_NAME="${APP_NAME}"
